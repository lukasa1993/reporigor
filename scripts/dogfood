#!/bin/sh
set -eu

workspace=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
artifact_dir=${REPORIGOR_DOGFOOD_DIR:-"$workspace/target/dogfood"}
mkdir -p "$artifact_dir"

if [ "$#" -gt 1 ]; then
  echo "usage: scripts/dogfood [REPORIGOR_BINARY]" >&2
  exit 2
fi

if [ "$#" -eq 1 ]; then
  reporigor_bin=$1
elif [ -n "${REPORIGOR_BIN:-}" ]; then
  reporigor_bin=$REPORIGOR_BIN
else
  cargo_bin=${CARGO:-cargo}
  if ! command -v "$cargo_bin" >/dev/null 2>&1; then
    echo "dogfood: cargo was not found; pass a RepoRigor binary or set CARGO" >&2
    exit 1
  fi
  "$cargo_bin" build --quiet --locked --manifest-path "$workspace/Cargo.toml" \
    --package reporigor --bin reporigor
  reporigor_bin="$workspace/target/debug/reporigor"
fi

if [ ! -x "$reporigor_bin" ]; then
  echo "dogfood: RepoRigor executable not found at $reporigor_bin" >&2
  exit 1
fi

temporary_report=
cleanup() {
  if [ -n "$temporary_report" ] && [ -f "$temporary_report" ]; then
    rm -f -- "$temporary_report"
  fi
}
trap cleanup EXIT HUP INT TERM

assert_report() {
  report=$1
  label=$2
  for required in \
    '"schema_version": 1' \
    '"name": "reporigor"' \
    '"command": "check"' \
    '"crap_over_limit": 0' \
    '"duplicate_groups": 0' \
    '"mutation_errors": 0' \
    '"findings": 0' \
    '"parse_errors": 0' \
    '"diagnostics": 0'
  do
    if ! grep -Fq "$required" "$report"; then
      echo "dogfood: $label report did not contain required result: $required" >&2
      exit 1
    fi
  done
  if ! grep -Eq '"files": [1-9][0-9]*' "$report"; then
    echo "dogfood: $label report selected no files" >&2
    exit 1
  fi
}

run_check() {
  language=$1
  source_root=$2
  destination=$3
  temporary_report=$(mktemp "$artifact_dir/reporigor-${language}.XXXXXX")
  "$reporigor_bin" \
    --backend generic \
    --language "$language" \
    --include-tests \
    --format json \
    check "$source_root" \
    --min-tokens 300 \
    > "$temporary_report"
  assert_report "$temporary_report" "$language"
  mv -f -- "$temporary_report" "$destination"
  temporary_report=
}

run_check rust "$workspace/crates" "$artifact_dir/rust.json"
run_check bash "$workspace/scripts" "$artifact_dir/bash.json"

echo "dogfood: RepoRigor accepted its Rust and shell sources with zero findings"
echo "dogfood: reports are in $artifact_dir"
